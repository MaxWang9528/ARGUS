# Copy to .env (which git ignores) and fill in. ./lw loads it at startup; a variable
# already exported in your shell wins over the file.

# Claude moment judge ([judge] in config.toml). Key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Twitch stream discovery ([discovery] in config.toml). Create an app at
# https://dev.twitch.tv/console (redirect URL http://localhost), then copy both values.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
